{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "api", "postgres", "config", "dbSecret", "test"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "port", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "$ref": "#/definitions/resourcesBlock" },
            "limits": { "$ref": "#/definitions/resourcesBlock" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "initImage", "persistence", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
            },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "initImage": { "type": "string", "pattern": ".+:.+" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "$ref": "#/definitions/resourcesBlock" },
            "limits": { "$ref": "#/definitions/resourcesBlock" }
          }
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "clusterId", "heapOpts", "persistence", "resources", "topics"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
            },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "clusterId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "heapOpts": {
          "type": "string",
          "pattern": "^-Xm[xs][0-9]+[KMG]( -Xm[xs][0-9]+[KMG])?$"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "$ref": "#/definitions/resourcesBlock" },
            "limits": { "$ref": "#/definitions/resourcesBlock" }
          }
        },
        "topics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "dlq"],
          "properties": {
            "events": { "$ref": "#/definitions/topicBlock" },
            "dlq": { "$ref": "#/definitions/topicBlock" }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 10 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "$ref": "#/definitions/resourcesBlock" },
            "limits": { "$ref": "#/definitions/resourcesBlock" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MODE"],
      "properties": {
        "MODE": { "enum": ["DEV", "TEST", "LOCAL", "PROD"] }
      }
    },
    "dbSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "resourcesBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
        "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
      }
    },
    "topicBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "partitions"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "partitions": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    }
  }
}
